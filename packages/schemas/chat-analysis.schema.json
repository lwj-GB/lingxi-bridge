{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingxi.local/schemas/chat-analysis.schema.json",
  "title": "Source-linked chat analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "topic_method",
    "metrics",
    "top_terms",
    "speakers",
    "time_buckets",
    "topics",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "sha256", "source_kind"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "title": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_kind": {"type": "string"}
      }
    },
    "topic_method": {
      "type": "string",
      "enum": ["local_frequency_clues", "cli_assisted"]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "characters",
        "non_whitespace_characters",
        "lines",
        "messages",
        "participants",
        "timestamped_messages"
      ],
      "properties": {
        "characters": {"type": "integer", "minimum": 0},
        "non_whitespace_characters": {"type": "integer", "minimum": 0},
        "lines": {"type": "integer", "minimum": 0},
        "messages": {"type": "integer", "minimum": 0},
        "participants": {"type": "integer", "minimum": 0},
        "timestamped_messages": {"type": "integer", "minimum": 0}
      }
    },
    "top_terms": {
      "type": "array",
      "maxItems": 16,
      "items": {"$ref": "#/$defs/frequencyItem"}
    },
    "speakers": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/countShare"},
          {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {"type": "string", "minLength": 1, "maxLength": 80}
            }
          }
        ]
      }
    },
    "time_buckets": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/countShare"},
          {
            "type": "object",
            "required": ["label"],
            "properties": {
              "label": {"type": "string", "minLength": 1, "maxLength": 20}
            }
          }
        ]
      }
    },
    "topics": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "summary",
          "keywords",
          "message_count",
          "message_share",
          "source_refs"
        ],
        "properties": {
          "title": {"type": "string", "minLength": 1, "maxLength": 80},
          "summary": {"type": "string", "minLength": 1, "maxLength": 600},
          "keywords": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 40}
          },
          "message_count": {"type": "integer", "minimum": 1},
          "message_share": {"type": "number", "minimum": 0, "maximum": 1},
          "source_refs": {
            "type": "array",
            "maxItems": 3,
            "items": {"$ref": "#/$defs/sourceRef"}
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1, "maxLength": 300}
    }
  },
  "$defs": {
    "countShare": {
      "type": "object",
      "required": ["message_count", "message_share"],
      "properties": {
        "message_count": {"type": "integer", "minimum": 0},
        "message_share": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "frequencyItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term", "count", "message_count", "message_share"],
      "properties": {
        "term": {"type": "string", "minLength": 1, "maxLength": 40},
        "count": {"type": "integer", "minimum": 1},
        "message_count": {"type": "integer", "minimum": 1},
        "message_share": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message_index", "start", "end", "quote"],
      "properties": {
        "message_index": {"type": "integer", "minimum": 0},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1},
        "quote": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    }
  }
}
