{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingxi.local/schemas/0.1/screenshot-recognition.schema.json",
  "title": "Lingxi Bridge V0.1 screenshot recognition result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "segments"],
        "properties": {
          "source_id": {
            "type": "string",
            "format": "uuid"
          },
          "segments": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["order", "speaker", "text", "uncertainty"],
              "properties": {
                "order": {"type": "integer", "minimum": 0},
                "speaker": {"enum": ["me", "other", "unknown"]},
                "text": {"type": "string", "minLength": 1, "maxLength": 4000},
                "uncertainty": {"enum": ["low", "medium", "high"]}
              }
            }
          }
        }
      }
    }
  }
}
